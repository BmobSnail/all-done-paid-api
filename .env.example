# ============= 应用基础 =============
PAID_APP_NAME=all-done-paid-api
PAID_APP_ENV=development          # development / test / production
PAID_LOG_LEVEL=INFO

# ============= gunicorn / uvicorn =============
PAID_WEB_HOST=0.0.0.0
PAID_WEB_PORT=8001
PAID_WEB_CONCURRENCY=4            # workers
PAID_GUNICORN_TIMEOUT=120
PAID_GUNICORN_GRACEFUL_TIMEOUT=30

# ============= Database (共享老 PG) =============
# 历史遗留：PG 库名/用户名保持 omniknight（数据层不迁移，命名规范 v3.0 §4）
PAID_DB_URL=postgresql+asyncpg://omniknight:CHANGEME@localhost:5432/omniknight
PAID_DB_POOL_SIZE=20
PAID_DB_MAX_OVERFLOW=10
PAID_DB_POOL_TIMEOUT=30

# ============= Redis (独立实例) =============
PAID_REDIS_URL=redis://localhost:6379/0
PAID_REDIS_MAX_CONNECTIONS=50

# ============= API Key (HMAC pepper) =============
PAID_API_KEY_PEPPER=CHANGEME_use_long_random_string_here   # 至少 32 字节随机
PAID_API_KEY_PREFIX=sk_live_

# ============= Rate Limit =============
PAID_DEFAULT_QPS_LIMIT=10
PAID_DEFAULT_CONCURRENCY_LIMIT=20
PAID_RATE_LIMIT_REDIS_PREFIX=paid:rl

# ============= Idempotency =============
PAID_IDEMPOTENCY_TTL_SECONDS=86400

# ============= LLM (SiliconFlow) =============
PAID_LLM_PROVIDER=siliconflow
PAID_LLM_BASE_URL=https://api.siliconflow.cn/v1
PAID_LLM_API_KEYS=sk-CHANGEME                              # 多 Key 用逗号分隔
PAID_LLM_MODEL_PRIMARY=deepseek-ai/DeepSeek-V3.1-Terminus
PAID_LLM_MODEL_FALLBACK=deepseek-ai/DeepSeek-V3.2-Exp
PAID_LLM_MODEL_CHEAP=Qwen/Qwen3-8B
PAID_LLM_TIMEOUT_SECONDS=60
PAID_LLM_MAX_RETRIES=3
PAID_LLM_MAX_CONCURRENCY=20
PAID_LLM_STREAM_TIMEOUT_SECONDS=120

# ============= Logfire =============
PAID_LOGFIRE_ENABLED=false
PAID_LOGFIRE_TOKEN=
PAID_LOGFIRE_ENV=development
PAID_LOGFIRE_SERVICE_NAME=all-done-paid-api
PAID_LOGFIRE_SCRUB_FIELDS=Authorization,X-API-Key,Cookie,phone,email,id_card

# ============= Cache =============
PAID_MEIHUA_CAST_CACHE_TTL_SECONDS=86400
PAID_PROMPT_VERSION=v1

# ============= Internal =============
PAID_INTERNAL_BYPASS_ENABLED=false  # 生产强制 false
PAID_CORS_ALLOW_ORIGINS=            # 默认空 = 关闭浏览器调用
